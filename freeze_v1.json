  "labels": {
    "failure": "episode ends by termination before step 500 (truncation at 500 = success)",
    "onset": "shifts are static from step 0",
    "deferred": "point-of-no-return label, fallback definition, detector list, metrics, warning horizon"
  },
  "holdout": {
    "scheme": "leave-one-class-out over AUTH, FAST, SLOW",
    "primary_fold": "FAST",
    "why": "FAST failures occur at ~150-450 steps, leaving room to warn; AUTH (~60) and SLOW (~16-35) fail too fast, so they are secondary and their limits must be stated",
    "never_used_to_fit_or_tune": [
      "HEAVYPOLE",
      "COMPOUND",
      "CONTROL"
    ]
  },
  "statistics": {
    "bootstrap": "over policies, percentile, 95%, B=10000",
    "multiplicity": "P1-P3 are three stand-alone confirmatory tests, no correction; every other analysis is labelled exploratory",
    "amendment_rule": "any change after this file is logged requires a new version, a reason, and a statement of which data had been seen"
  },
  "preregistered": {
    "P1_margin": {
      "claim": "Policies with larger nominal angle excursions fail more when authority is cut (mechanism: margin).",
      "statistic": "Spearman rho (average ranks) between nominal mean max|theta| over env seeds 20000-20099 and failure rate at masscartx16 over test seeds 50000+, across the 20 test policies",
      "supported": "rho >= +0.5",
      "not_supported": "rho < +0.5",
      "inconclusive": "fewer than 5 distinct failure rates at x16, or zero spread in nominal margin",
      "always_report": "percentile bootstrap 95% CI over policies, B=10000, rng seed 0",
      "power_note": "with n=20 and true rho=0.5 the observed rho falls below 0.5 about half the time; the CI, not the threshold, is the evidence"
    },
    "P2_window": {
      "claim": "A policy tuned to nominal omega rarely tolerates both a faster (length x0.2, omega ratio ~2.2) and slower (length x2, ~0.7) pole (mechanism: window).",
      "statistic": "count of the 20 test policies with failure rate <= 0.05 on BOTH lengthx0.2 and lengthx2",
      "supported": "count <= 2",
      "refuted": "count >= 6",
      "inconclusive": "3 to 5"
    },
    "P3_compound": {
      "claim": "Failure is governed by hold angle, not parameter identity: two individually harmless shifts that cut hold_deg to ~3.6 deg fail; a shift that restores ~16.7 deg is harmless though force x0.1 alone fails (mechanism: authority).",
      "statistic": "means over the 20 test policies of failure rate",
      "preconditions": "force_magx0.25 <= 0.05, masscartx4 <= 0.05, masscartx0.25 <= 0.05, force_magx0.1 >= 0.20, else inconclusive_preconditions",
      "supported": "C1 (force_magx0.25|masscartx4) >= 0.40 AND C2 (force_magx0.1|masscartx0.25) <= 0.05",
      "refuted": "C1 <= 0.10 OR C2 >= 0.20",
      "inconclusive": "otherwise"
    },
    "executable_verdicts": {
      "source": "\nimport numpy as np, pandas as pd\ndef _rho(a, b):\n    return float(pd.Series(a).rank().corr(pd.Series(b).rank()))\ndef p1_verdict(margin, F, B=10000, seed=0):\n    idx = F.index\n    if len(idx) != 20: raise ValueError(\"P1 registered for exactly 20 test policies\")\n    a = margin.loc[idx].to_numpy(float); b = F[\"masscartx16\"].to_numpy(float)\n    if np.std(a) == 0 or len(np.unique(b)) < 5:\n        return dict(verdict=\"inconclusive_degenerate\", rho=None, ci95=None)\n    rho = _rho(a, b); rng = np.random.default_rng(seed); bs = []\n    for _ in range(B):\n        i = rng.integers(0, len(a), len(a)); r = _rho(a[i], b[i])\n        if not np.isnan(r): bs.append(r)\n    return dict(verdict=\"supported\" if rho >= 0.5 else \"not_supported\", rho=rho,\n                ci95=[float(np.percentile(bs, 2.5)), float(np.percentile(bs, 97.5))])\ndef p2_verdict(F):\n    if len(F) != 20: raise ValueError(\"P2 registered for exactly 20 test policies\")\n    n = int(((F[\"lengthx0.2\"] <= 0.05) & (F[\"lengthx2\"] <= 0.05)).sum())\n    return dict(verdict=\"supported\" if n <= 2 else \"refuted\" if n >= 6 else \"inconclusive\", count=n)\ndef p3_verdict(F):\n    m = F.mean()\n    pre = {\"force_magx0.25<=0.05\": m[\"force_magx0.25\"] <= 0.05, \"masscartx4<=0.05\": m[\"masscartx4\"] <= 0.05,\n           \"masscartx0.25<=0.05\": m[\"masscartx0.25\"] <= 0.05, \"force_magx0.1>=0.20\": m[\"force_magx0.1\"] >= 0.20}\n    c1 = float(m[\"force_magx0.25|masscartx4\"]); c2 = float(m[\"force_magx0.1|masscartx0.25\"])\n    if not all(pre.values()): v = \"inconclusive_preconditions\"\n    elif c1 >= 0.40 and c2 <= 0.05: v = \"supported\"\n    elif c1 <= 0.10 or c2 >= 0.20: v = \"refuted\"\n    else: v = \"inconclusive\"\n    return dict(verdict=v, C1=c1, C2=c2, preconditions={k: bool(x) for k, x in pre.items()})\n",
      "sha256_16": "1c8fca9ba9d6e520"
    }
  }
