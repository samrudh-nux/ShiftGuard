  "working_question": "Do onset-labelled detector evaluations agree with failure-relevant (point-of-no-return) evaluations, and how stable are detector conclusions across policies, fallback choice and held-out effective-dynamics classes? PROVISIONAL pending the literature recheck before the detector-protocol freeze.",
  "theory": {
    "axes": {
      "omega": "sqrt(g/(l*k)), k = 4/3 - m_pole/M: growth rate of a pole-angle error with the cart unforced; sets how fast an error must be corrected",
      "hold_deg": "degrees(F/(M*g)), small-angle approximation: pole lean that the maximum constant push can hold; this is control authority",
      "authority_margin": "hold_deg / termination angle: below ~1 the controller cannot always catch a lean that ends the episode"
    },
    "mechanisms": {
      "authority": "Failure under AUTH and COMPOUND shifts is governed by hold_deg, not by which parameter changed.",
      "window": "A policy tuned to nominal omega tolerates only a band of omega; wide tolerance on both sides is rare.",
      "margin": "Policies with larger nominal angle excursions have less spare authority, so fail first when authority is cut."
    },
    "note": "Mechanisms are hypotheses motivated by the design data (dev policies), not established facts."
  },
  "unit_of_analysis": "policy (training seed). Per-policy rate = failures/50 episodes; the 20 policies are weighted equally; episodes are never pooled across policies.",
